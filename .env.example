# Copy this file to .env and fill in the three LLM_ values.
# Any OpenAI-compatible endpoint works. Examples of LLM_BASE_URL:
#   OpenAI        https://api.openai.com/v1
#   OpenRouter    https://openrouter.ai/api/v1
#   Groq          https://api.groq.com/openai/v1
#   Ollama        http://localhost:11434/v1      (LLM_API_KEY can be any text, e.g. "ollama")
#   LM Studio     http://localhost:1234/v1       (LLM_API_KEY can be any text)

# --- Chat model (required) ---------------------------------------------------
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=your-key
LLM_MODEL=your-model-name

# --- Embeddings (optional; used from module 03) -------------------------------
# Leave the URL and key empty to reuse the chat endpoint and key.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Empty = run a small embedding model on this machine (needs the "rag" packages).
# Or name a hosted model, e.g. text-embedding-3-small. "local:<name>" picks a local one.
EMBEDDING_MODEL=

# --- Behaviour (optional) -----------------------------------------------------
# Seconds to wait for the model before giving up.
LLM_TIMEOUT=60

# --- Services for the infrastructure modules (optional; added in later phases) -
# Each may point at a local container, a native install or a cloud instance.
# REDIS_URL=redis://localhost:6379/0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# PROMETHEUS_URL=http://localhost:9090
# GRAFANA_URL=http://localhost:3000
# N8N_URL=http://localhost:5678
# LANGSMITH_API_KEY=
