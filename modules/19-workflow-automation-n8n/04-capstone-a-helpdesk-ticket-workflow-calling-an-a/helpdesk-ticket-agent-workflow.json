{
  "name": "Larkspur ticket intake with agent",
  "nodes": [
    {
      "id": "f4d0a1a0-0001-4000-8000-000000000001",
      "name": "Ticket Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "f4d0a1a0-0001-4000-8000-0000000000cc",
      "parameters": { "httpMethod": "POST", "path": "helpdesk-intake", "responseMode": "responseNode", "options": {} }
    },
    {
      "id": "f4d0a1a0-0002-4000-8000-000000000002",
      "name": "Has a ticket?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [240, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "e1000000-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.body.ticket }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f4d0a1a0-0003-4000-8000-000000000003",
      "name": "Triage agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, -100],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8008/triage",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": { "parameters": [ { "name": "ticket", "value": "={{ $json.body.ticket }}" } ] },
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "f4d0a1a0-0004-4000-8000-000000000004",
      "name": "Urgent?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [720, -200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "e1000000-0000-4000-8000-000000000002",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "high",
              "operator": { "type": "string", "operation": "equals" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f4d0a1a0-0005-4000-8000-000000000005",
      "name": "Mark escalated",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, -300],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a4000000-0000-4000-8000-000000000001", "name": "status", "value": "escalated to on-call", "type": "string" },
            { "id": "a4000000-0000-4000-8000-000000000002", "name": "category", "value": "={{ $json.category }}", "type": "string" },
            { "id": "a4000000-0000-4000-8000-000000000003", "name": "reply", "value": "={{ $json.reply }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f4d0a1a0-0006-4000-8000-000000000006",
      "name": "Mark queued",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [960, -100],
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a4000000-0000-4000-8000-000000000004", "name": "status", "value": "queued", "type": "string" },
            { "id": "a4000000-0000-4000-8000-000000000005", "name": "category", "value": "={{ $json.category }}", "type": "string" },
            { "id": "a4000000-0000-4000-8000-000000000006", "name": "reply", "value": "={{ $json.reply }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f4d0a1a0-0007-4000-8000-000000000007",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, -200],
      "parameters": { "respondWith": "json", "responseBody": "={{ $json }}", "options": { "responseCode": 200 } }
    },
    {
      "id": "f4d0a1a0-0008-4000-8000-000000000008",
      "name": "Respond bad request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [480, 160],
      "parameters": { "respondWith": "json", "responseBody": "{\"error\": \"field 'ticket' is required\"}", "options": { "responseCode": 422 } }
    },
    {
      "id": "f4d0a1a0-0009-4000-8000-000000000009",
      "name": "Respond agent down",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 60],
      "parameters": { "respondWith": "json", "responseBody": "{\"error\": \"triage is unavailable, your ticket was not lost, please retry later\"}", "options": { "responseCode": 503 } }
    }
  ],
  "connections": {
    "Ticket Webhook": { "main": [[{ "node": "Has a ticket?", "type": "main", "index": 0 }]] },
    "Has a ticket?": {
      "main": [
        [{ "node": "Triage agent", "type": "main", "index": 0 }],
        [{ "node": "Respond bad request", "type": "main", "index": 0 }]
      ]
    },
    "Triage agent": {
      "main": [
        [{ "node": "Urgent?", "type": "main", "index": 0 }],
        [{ "node": "Respond agent down", "type": "main", "index": 0 }]
      ]
    },
    "Urgent?": {
      "main": [
        [{ "node": "Mark escalated", "type": "main", "index": 0 }],
        [{ "node": "Mark queued", "type": "main", "index": 0 }]
      ]
    },
    "Mark escalated": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] },
    "Mark queued": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "active": false
}
